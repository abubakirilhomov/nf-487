# Скопируй этот файл в .env и вставь свой ключ с https://home.openweathermap.org/api_keys
VITE_OWM_API_KEY=70e83d66b6d654148b3151715cd4f899

# false — бесплатный тариф (текущая погода + прогноз на 5 дней)
# true  — One Call API 3.0 (прогноз на 8 дней + УФ-индекс), нужна подписка "One Call by Call"
VITE_OWM_ONECALL=true
